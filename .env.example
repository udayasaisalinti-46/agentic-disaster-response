# ResQAI Environment Configuration Template
# Copy this file to .env and fill in your database credentials

# PostgreSQL Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=disaster_response
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Alternative: Single Connection String (commonly provided by Render / Neon / Supabase)
# DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/disaster_response

# Offline / SQLite Development Mode
# Set to 'true' to use local SQLite without requiring a running PostgreSQL server
USE_SQLITE=false
